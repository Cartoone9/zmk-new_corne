#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE    0
#define CODE    1
#define EXTRA   2
#define NAV     3
#define NAV2    4
#define NUM     5
#define FN      6
#define BLT     7

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_kj_esc {
            timeout-ms = <50>;
            key-positions = <23 24>; // J and K positions
            bindings = <&kp ESC>;
            layers = <0>;
        };
//        combo_mcomma_enter {
//            timeout-ms = <50>;
//            key-positions = <37 38>; // M and , positions
//            bindings = <&kp ENTER>;
//            layers = <0>;
//        };
        combo_df_numpad {
            timeout-ms = <50>;
            key-positions = <16 17>; // D and F positions
            bindings = <&mo NUM>;
            layers = <0>;
        };
//        combo_cv_fn {
//            timeout-ms = <50>;
//            key-positions = <31 32>; // C and V positions
//            bindings = <&mo FN>;
//            layers = <0>;
//        };
        combo_sdf_fn {
            timeout-ms = <50>;
            key-positions = <15 16 17>; // S, D and F positions
            bindings = <&mo FN>;
            layers = <0>;
        };
        combo_asdf_nav2 {
            timeout-ms = <50>;
            key-positions = <14 15 16 17>; // A, S, D and F positions
            bindings = <&mo NAV2>;
            layers = <0>;
        };
        combo_slash_end_blt {
            timeout-ms = <50>;
            key-positions = <40 41>; // / (right of DOT) and END positions
            bindings = <&mo BLT>;
            layers = <0>;
        };
    };

    behaviors {
        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_SHIFT>, <&led_caps_lock>;
        };
        // Backspace; Shift+Backspace deletes the previous word (Alt+Backspace)
        bspc_word: bspc_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp LA(BSPC)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Layer-tap with a custom tap behavior (same timing as &lt)
        lt_bspc: lt_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&bspc_word>;
        };
        f_nav2: f_nav2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F_NAV2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp F>, <&sl NAV2>;
        };

        // desktop shortcuts
        desk_5: desk_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&macro_press &kp LALT>,
                <&macro_tap &kp N5>,
                <&macro_release &kp LALT>;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&macro_press &kp LALT>,
                <&macro_tap &kp TAB>,
                <&macro_release &kp LALT>;
        };
        ctrl_bspc: ctrl_bspc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&macro_press &kp LCTRL>,
                <&macro_tap &kp BSPC>,
                <&macro_release &kp LCTRL>;
        };
		led_caps_lock: led_caps_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&macro_tap &kp CAPS>,
                <&macro_tap &rgb_ug RGB_TOG>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp DEL    &kp Q     &kp W      &kp E     &kp R			&kp T                                  &none                       &kp Y           &kp U        &kp I      &kp O    &kp P       &kp LA(SPACE)
&kp TAB    &kp A     &kp S      &kp D     &kp F			&kp G                           &none  &none    &none              &kp H           &kp J        &kp K      &kp L    &kp SEMI    &kp HOME
&kp LCTRL  &kp Z     &kp X      &kp C     &kp V			&kp B            &none                 &none                       &kp N           &kp M        &kp COMMA  &kp DOT  &kp FSLH    &kp END
                                &kp LGUI  &shift_caps   &lt EXTRA SPACE                                                    &lt_bspc CODE 0 &kp ENTER    &kp LALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        code_layer {
            display-name = "CODE";
            bindings = <
&trans    &kp TILDE   &kp LT        &kp GT      &kp PERCENT    &kp BSLH                                 &none                   &kp PLUS         &kp DQT      &kp LBRC   &kp RBRC  &kp COLON     &trans   
&trans    &kp HASH    &kp EXCL      &kp EQUAL   &kp AMPS       &kp PIPE                        &none    &none    &none          &kp MINUS        &kp SQT      &kp LPAR   &kp RPAR  &trans        &trans   
&trans    &kp GRAVE   &kp CARET     &kp DOLLAR  &kp AT         &kp QMARK           &none                &none                   &kp UNDER        &kp STAR     &kp LBKT   &kp RBKT  &none         &trans   
                                    &trans      &trans         &lt NAV SPACE                                                    &trans           &trans       &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        extra_layer {
            display-name = "EXTRA";
            bindings = <
&none     &none            &kp C_BRI_DN	 &kp C_BRI_UP   &none           &none                                   &none                 &kp K_LOCK	   &kp PGDN    &kp PGUP  &kp PSCRN  &none	  &trans
&none     &kp LGUI	   &kp LALT      &kp LSHIFT     &kp LCTRL       &none                          &none    &none    &none        &kp LEFT  	   &kp DOWN    &kp UP    &kp RIGHT  &none      &trans
&trans    &kp C_MUTE       &kp C_VOL_DN  &kp C_VOL_UP   &kp C_PP        &kp C_NEXT		&none				    &none				  &kp F18   	   &kp F19     &kp F20   &kp F21    &kp F22    &trans
									     &trans		    &trans          &trans														  &lt NAV BSPC     &trans      &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&none     &none       &kp LA(LS(N1))  &kp LA(LS(N2))  &kp LA(LS(N3))  &kp LA(LS(N4))                          &none                   &kp LS(TAB)    &kp TAB     &kp LALT       &none          &none     &none
&none     &none       &kp LA(N1)      &kp LA(N2)      &kp LA(N3)      &kp LA(N4)                       &none  &none    &none          &kp LA(LEFT)   &kp LA(W)   &kp LA(ENTER)  &kp LA(RIGHT)  &none     &none
&none     &none       &none           &none           &none           &none                 &none             &none                   &none          &none       &none          &none          &none     &none
                                      &none           &none           &none                                                           &none          &none       &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        nav2_layer {
            display-name = "NAV2";
            bindings = <
&none     &none     &none      &none      &none       &none                           &none                   &none         &kp LG(U)     &kp LG(ENTER)      &kp LG(I)      &none      &none
&none     &none     &none      &none      &none       &none                    &none  &none    &none          &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(UP)         &kp LG(RIGHT)  &none      &none
&none     &none     &none      &none      &none       &none         &none             &none                   &none         &kp LG(J)     &kp LG(LS(ENTER))  &kp LG(K)      &none      &none
                               &none      &none       &none                                                   &none         &none         &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        numpad_layer {
            display-name = "NUM";
            bindings = <
&none     &none     &none      &none      &none       &none                              &none					&kp FSLH    &kp N7     &kp N8     &kp N9     &kp PLUS   &none
&none     &none     &none      &none      &none       &none                     &none    &none    &none         &kp MINUS	&kp N4     &kp N5     &kp N6     &kp STAR   &none
&none     &none     &none      &none      &none       &none            &none             &none					&kp N0      &kp N1     &kp N2     &kp N3     &kp DOT    &none
                               &none      &none       &none                                                     &kp BSPC    &trans     &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&none     &none     &none      &none      &none       &none                                    &none                         &none       &kp F7     &kp F8     &kp F9     &kp F12    &none
&none     &none     &none      &none      &none       &none                           &none    &none    &none                &none       &kp F4     &kp F5     &kp F6     &kp F11    &none
&none     &none     &none      &none      &none       &none            &none                   &none                         &none       &kp F1     &kp F2     &kp F3     &kp F10    &none
                               &none      &none       &none                                                                  &none       &none      &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        blt_layer {
            display-name = "BLT";
            bindings = <
&none    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_BRI    &rgb_ug RGB_BRD                  &none                    &rgb_ug RGB_HUI       &rgb_ug RGB_HUD         &rgb_ug RGB_SAI        &rgb_ug RGB_SAD       &none     &none
&none    &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2                    &bt BT_SEL 3       &bt BT_SEL 4             &none   &none    &none           &none       &none         &none        &none       &none     &none
&none    &bt BT_CLR       &none            &none                           &none              &bt BT_CLR_ALL      &none        &none                    &none       &none         &none        &none       &none     &none
                          &none            &none                           &none                                                                        &none       &none         &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
